DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DATABASE_URL=postgresql://user:password@localhost:5432/bbd_scheduler
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-smtp-user@example.com
EMAIL_HOST_PASSWORD=replace-with-secret
DEFAULT_FROM_EMAIL=BBD Smart Scheduler <no-reply@example.com>
FRONTEND_URL=http://localhost:3000
WHATSAPP_ENABLED=False
WHATSAPP_ACCESS_TOKEN=replace-with-secret
WHATSAPP_PHONE_NUMBER_ID=replace-with-id
WHATSAPP_APP_SECRET=replace-with-secret
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-secret
